# Get this connection string from Neon (neon.tech) or Supabase after creating your free Postgres database
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string - used to sign admin login sessions
JWT_SECRET="change-this-to-a-long-random-string"

# Used only once, by `npm run seed`, to create your first admin login
SEED_ADMIN_EMAIL="admin@fusiontreats.uk"
SEED_ADMIN_PASSWORD="ChangeMe123!"
